---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';

const info = (await getEntry('info', 'info'))!.data;
const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Placeholder names so the list matches the Figma layout (5 items).
// They disappear automatically as real projects are added.
const placeholders = ['Project 2', 'Project 3', 'Project 4', 'Project 5'].slice(
  0,
  Math.max(0, 5 - projects.length),
);

const introLines = info.intro.split('\n');
const hasMore = info.introMore.length > 0;
---

<Base bodyClass="is-home" description={info.intro.replace(/\s+/g, ' ')}>
  <main id="main" class="home">
    <section class="intro">
      <a class="corner text-hover" href="/info#contact">Contact</a>

      <div class="bio" data-open="false">
        <h1 class="visually-hidden">{info.name}</h1>
        {
          hasMore ? (
            <button class="bio-toggle" type="button" aria-expanded="false" aria-controls="bio-more">
              <span class="bio-text">
                {introLines.map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
              </span>
              <svg class="bio-arrow" width="15" height="14" viewBox="0 0 15 14" aria-hidden="true">
                <rect width="15" height="14" rx="4" fill="#E9E9E9" />
                <path d="M4.9 4.9h5.2L7.5 9.3z" fill="#000" stroke="#000" stroke-width="0.8" stroke-linejoin="round" />
              </svg>
              <span class="visually-hidden">Read more about Damir</span>
            </button>
          ) : (
            <p class="bio-text">{info.intro}</p>
          )
        }
        {
          hasMore && (
            <div id="bio-more" class="bio-more">
              <div class="bio-more-inner">
                {info.introMore.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <a class="corner text-hover" href="/info">Experience</a>
    </section>

    <section class="work" aria-labelledby="work-heading">
      <h2 id="work-heading" class="visually-hidden">Selected work</h2>

      <!-- Desktop: the panel shows the hovered project's cover -->
      <div class="previews" aria-hidden="true">
        {
          projects.map((p, i) => (
            <div class="preview" data-index={i} style={`--accent: ${p.data.color}`}>
              <Media image={p.data.cover} alt="" span="half" />
            </div>
          ))
        }
      </div>

      <ul class="list">
        {
          projects.map((p, i) => (
            <li class="item">
              <a class="item-link" href={`/work/${p.id}/`} data-index={i}>
                {/* Phones: each project shows its own cover */}
                <span class="card-media">
                  <Media image={p.data.cover} alt={p.data.coverAlt} span="half" eager={i === 0} />
                </span>
                <span class="item-label">{p.data.title}</span>
              </a>
            </li>
          ))
        }
        {
          placeholders.map((name) => (
            <li class="item item-placeholder" aria-hidden="true">
              <span class="item-label">{name}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>

<script>
  // ---- Intro: arrow expands / collapses the extra text ----
  const bio = document.querySelector<HTMLElement>('.bio');
  const toggle = document.querySelector<HTMLButtonElement>('.bio-toggle');

  function setOpen(open: boolean) {
    if (!bio || !toggle) return;
    bio.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => setOpen(bio?.dataset.open !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && bio?.dataset.open === 'true') {
      setOpen(false);
      toggle?.focus();
    }
  });

  // ---- Work: hovering / focusing a project shows its cover ----
  const work = document.querySelector<HTMLElement>('.work');
  const previews = document.querySelectorAll<HTMLElement>('.preview');
  const links = document.querySelectorAll<HTMLAnchorElement>('.item-link');

  function show(index: string | null) {
    previews.forEach((el) => el.toggleAttribute('data-active', el.dataset.index === index));
    links.forEach((el) => el.toggleAttribute('data-active', el.dataset.index === index));
    work?.toggleAttribute('data-previewing', index !== null);
  }

  links.forEach((link) => {
    link.addEventListener('pointerenter', () => show(link.dataset.index ?? null));
    link.addEventListener('focus', () => show(link.dataset.index ?? null));
    link.addEventListener('pointerleave', () => show(null));
    link.addEventListener('blur', () => show(null));
  });
</script>

<style>
  /* ---------- Desktop: two columns, one screen tall (Figma 1:2328) ---------- */
  .home {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    height: 100svh;
    min-height: 560px;
    padding: var(--space-2);
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
  }

  .text-hover {
    transition: color var(--duration) var(--ease-out);
  }
  .text-hover:hover {
    color: var(--color-hover);
  }

  /* ---------- Intro + expandable text ---------- */
  .bio {
    position: relative;
    width: 253px;
  }

  .bio-toggle {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: center;
    cursor: pointer;
  }

  .bio-text {
    transition: color var(--duration) var(--ease-out);
  }

  .bio-toggle:hover .bio-text,
  .bio[data-open='true'] .bio-text {
    color: var(--color-hover);
  }

  .bio-arrow {
    display: inline-block;
    margin-left: 4px;
    vertical-align: -2px;
    transition: transform var(--duration) var(--ease-out);
  }

  .bio[data-open='true'] .bio-arrow {
    transform: rotate(180deg);
  }

  /* Sits below the intro so the intro itself never moves */
  .bio-more {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 500ms var(--ease-out),
      opacity 400ms var(--ease-out),
      visibility 0s linear 500ms;
  }

  .bio[data-open='true'] .bio-more {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows 500ms var(--ease-out),
      opacity 400ms var(--ease-out) 100ms,
      visibility 0s;
  }

  .bio-more-inner {
    display: grid;
    gap: 1.3em;
    min-height: 0;
    overflow: hidden;
    padding-top: var(--space-2);
  }

  /* ---------- Work panel ---------- */
  .work {
    position: relative;
    overflow: hidden;
    background: var(--color-panel);
  }

  .previews,
  .preview {
    position: absolute;
    inset: 0;
  }

  .preview {
    background: var(--accent);
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 600ms var(--ease-out),
      transform 900ms var(--ease-out);
  }

  .preview[data-active] {
    opacity: 1;
    transform: none;
  }

  .preview :global(.media) {
    border-radius: 0;
  }

  .list {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    height: 100%;
    text-align: center;
  }

  .card-media {
    display: none;
  }

  .item-label {
    display: inline-block;
    padding: 0 6px;
    border-radius: 4px;
    transition:
      color var(--duration) var(--ease-out),
      background-color var(--duration) var(--ease-out);
  }

  .item-link:hover .item-label {
    color: var(--color-hover);
  }

  /* While a cover is showing, give names a soft backing so they stay readable */
  .work[data-previewing] .item-label {
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
  }
  .work[data-previewing] .item-link[data-active] .item-label {
    color: var(--color-ink);
    background: var(--color-surface);
  }

  /* ---------- Tablet & phone: stacked ---------- */
  @media (max-width: 800px) {
    .home {
      display: block;
      height: auto;
      min-height: 0;
    }

    .intro {
      gap: var(--space-5);
      padding: var(--space-1) 0 var(--space-5);
    }

    /* On small screens the extra text pushes content down instead of overlaying */
    .bio-more {
      position: static;
    }

    .work {
      overflow: visible;
      background: none;
    }

    .previews,
    .item-placeholder {
      display: none;
    }

    .list {
      display: grid;
      gap: var(--space-4);
      height: auto;
    }

    .item-link {
      display: grid;
      gap: var(--space-2);
    }

    .card-media {
      display: block;
      aspect-ratio: 4 / 5;
    }
  }
</style>
