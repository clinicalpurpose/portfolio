---
// /info is the homepage with the Info state already open (Figma 15:64).
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';

const info = (await getEntry('info', 'info'))!.data;
---

<Base title="Info" bodyClass="is-home" description={info.intro.replace(/\s+/g, ' ')}>
  <Home infoOpen />
</Base>
