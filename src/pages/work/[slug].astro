---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Media from '../../components/Media.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined,
    },
  }));
}

interface Props {
  project: CollectionEntry<'work'>;
  next?: CollectionEntry<'work'>;
}

const { project, next } = Astro.props;
const { title, client, year, role, summary, blocks } = project.data;
const meta = [
  client && { label: 'Client', value: client },
  year && { label: 'Year', value: String(year) },
  role && { label: 'Role', value: role },
].filter(Boolean) as { label: string; value: string }[];
---

<Base title={title} description={summary}>
  <header class="top">
    <Nav />
  </header>

  <main id="main">
    <section class="head">
      <h1 class="visually-hidden">{title}</h1>
      <p class="summary">{summary}</p>
    </section>

    <div class="blocks">
      {
        blocks.map((block, i) =>
          'pair' in block ? (
            <div class="row pair">
              {block.pair.map((col) =>
                'stack' in col ? (
                  <div class="stack">
                    {col.stack.map((m) => (
                      <div class="cell reveal">
                        <Media image={m.image} alt={m.alt} span="half" />
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="cell reveal">
                    <Media image={col.image} alt={col.alt} span="half" eager={i === 0} />
                  </div>
                ),
              )}
            </div>
          ) : (
            <div class="row cell reveal">
              <Media image={block.image} alt={block.alt} eager={i === 0} />
            </div>
          ),
        )
      }
    </div>

    {
      meta.length > 0 && (
        <dl class="meta">
          {meta.map((m) => (
            <div>
              <dt class="muted">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      next && (
        <nav class="next" aria-label="Next project">
          <a class="next-link" href={`/work/${next.id}/`}>
            <span class="muted">Next project</span>
            <span>{next.data.title} →</span>
          </a>
        </nav>
      )
    }
  </main>

  <Footer />
</Base>

<style>
  .top {
    padding: var(--space-3) var(--page-pad) 0;
  }

  .head {
    display: flex;
    justify-content: center;
    padding: var(--space-6) var(--page-pad) var(--space-3);
    text-align: center;
  }

  .summary {
    max-width: 580px;
    font-size: var(--text-s);
  }

  .blocks {
    display: grid;
    gap: var(--space-3);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-pad);
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .stack {
    display: grid;
    gap: var(--space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-5) var(--page-pad) 0;
    text-align: center;
  }

  .next {
    display: flex;
    justify-content: center;
    padding-top: var(--space-5);
  }

  .next-link {
    display: grid;
    gap: 2px;
    text-align: center;
  }
  .next-link:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 700px) {
    .head {
      padding-top: var(--space-5);
    }
    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
